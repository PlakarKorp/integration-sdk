{
  "type": "Categorization",
  "options": {
    "variant": "stepper"
  },
  "elements": [
    {
      "type": "Category",
      "label": "Location",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/base_dir",
          "label": "Base directory"
        },
        {
          "type": "Control",
          "scope": "#/properties/parent",
          "label": "Parent directory",
          "options": {
            "widget": "select",
            "description": "Directories found under {base_dir}.",
            "optionsSource": {
              "resolver": "dirs",
              "params": {
                "base_dir": {
                  "scope": "#/properties/base_dir"
                }
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/name_prefix",
          "label": "Name prefix"
        },
        {
          "type": "Control",
          "scope": "#/properties/sftp_base",
          "label": "SFTP base URL"
        },
        {
          "type": "Control",
          "scope": "#/properties/ssh_identity",
          "label": "SSH identity file"
        }
      ]
    },
    {
      "type": "Category",
      "label": "Flavor",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/flavor",
          "label": "Flavor",
          "options": {
            "widget": "table",
            "columns": [
              "cpu",
              "ram",
              "price",
              "stock"
            ],
            "search": true,
            "optionsSource": {
              "resolver": "flavors",
              "params": {}
            }
          }
        }
      ]
    },
    {
      "type": "Category",
      "label": "Review",
      "elements": [
        {
          "type": "Summary"
        }
      ]
    }
  ]
}
